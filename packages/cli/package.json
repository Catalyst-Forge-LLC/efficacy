{
  "name": "efficacy",
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Create and verify efficacy records: machine-readable proof of tool success, written by agents, for agents.",
  "author": "Catalyst Forge LLC",
  "homepage": "https://efficacy.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/efficacy.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Catalyst-Forge-LLC/efficacy/issues"
  },
  "keywords": [
    "efficacy",
    "agents",
    "llm",
    "provenance",
    "evidence",
    "ed25519",
    "jsonl",
    "cli"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "efficacy": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.js",
    "prepack": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/hero.test.ts"
  },
  "devDependencies": {
    "@efficacy/core": "workspace:*",
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
